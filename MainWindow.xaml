<Window x:Class="pr3_wpf_v5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr3_wpf_v5"
        mc:Ignorable="d"
        Title="MainWindow" Height="640" Width="800">
    <DockPanel Background="AliceBlue">
        <TextBlock DockPanel.Dock="Top" Padding="15" Foreground="White" FontSize="16" Background="#FF4264C8">Запись на учебный курс</TextBlock>
        <StackPanel VerticalAlignment="Top" Background="White" Margin="10 10 10 10" DockPanel.Dock="Left" Height="495">
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="10 10 10 10" Foreground="#FF4264C8">Этапы записи</TextBlock>
            <TextBlock FontWeight="Bold" Margin="10 10 10 10" Background="#FFCCD8FC" Padding="5">1. Данные слушателя</TextBlock>
            <TextBlock Padding="5" Margin="10 10 10 10">2. Выбор курса</TextBlock>
            <TextBlock Padding="5" Margin="10 10 10 10">3. Подтверждение</TextBlock>
        </StackPanel>
        <Grid Background="White" DockPanel.Dock="Top" Margin="10" Height="498">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition  Height="30"/>
                <RowDefinition  Height="30"/>
                <RowDefinition  Height="30"/>
                <RowDefinition  Height="30"/>
                <RowDefinition  Height="30"/>
                <RowDefinition  Height="30"/>
                <RowDefinition  Height="30"/>
                <RowDefinition  Height="30"/>
                <RowDefinition  Height="30"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Margin="15 5 5 5" Grid.Row="0" VerticalAlignment="Center" Grid.Column="0">ФИО</TextBlock>
            <TextBox Margin="3" Grid.Column="1"></TextBox>

            <TextBlock Margin="15 5 5 5" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0">Эелектронная почта</TextBlock>
            <TextBox Margin="3" Grid.Row="1" Grid.Column="1"></TextBox>

            <TextBlock Margin="15 5 5 5" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0">Телефон</TextBlock>
            <TextBox Margin="3" Grid.Row="2" Grid.Column="1"></TextBox>

            <TextBlock Margin="15 5 5 5" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0">Учебное заведение</TextBlock>
            <TextBox Margin="3" Grid.Row="3" Grid.Column="1"></TextBox>

            <TextBlock Margin="15 5 5 5" Grid.Row="4"  VerticalAlignment="Center">Название курса</TextBlock>
            <ComboBox Margin="3" Grid.Row="4" Grid.Column="1">
                <ComboBoxItem>Разработка на C#</ComboBoxItem>
            </ComboBox>

            <TextBlock Margin="15 5 5 5" Grid.Row="5"  VerticalAlignment="Center">Уровень подготовки</TextBlock>
            <ComboBox Margin="3" Grid.Row="5" Grid.Column="1">
                <ComboBoxItem>Начальный</ComboBoxItem>
            </ComboBox>

            <TextBlock Margin="15 5 5 5" Grid.Row="6"  VerticalAlignment="Center">Дата начала</TextBlock>
            <DatePicker Margin="3" Grid.Row="6" Grid.Column="1">

            </DatePicker>

            <TextBlock Margin="15 5 5 5" Grid.Row="7"  VerticalAlignment="Center">Время занятий</TextBlock>
            <ComboBox Margin="3" Grid.Row="7" Grid.Column="1">
                <ComboBoxItem>Утро</ComboBoxItem>
            </ComboBox>

            <Grid VerticalAlignment="Center" Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <RadioButton Margin="15 0 5 0" Grid.Column="0" FontSize="11">Очно</RadioButton>
                <RadioButton Grid.Column="1" FontSize="11">Дистанционно</RadioButton>
            </Grid>
            <WrapPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,0,0,0">
                <TextBlock Margin="15 5 5 5" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#FF4264C8" Width="600">Интересующие темы</TextBlock>
                <CheckBox Margin="15 5 5 5" Content="C#"/>
                <CheckBox Margin="15 5 5 5" Content="WPF"/>
                <CheckBox Margin="15 5 5 5" Content="Базы данных"/>
                <CheckBox Margin="15 5 5 5" Content="Git"/>
                <CheckBox Margin="15 5 5 5" Content="Тестирование"/>
                <CheckBox Margin="15 5 5 5" Content="Web API"/>
            </WrapPanel>

            <TextBlock Grid.ColumnSpan="2" Grid.Row="10">Данные проверены</TextBlock>
        </Grid>
        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="50" Width="245">
            <Button Margin="5" Padding="10 0 10 0">Назад</Button>
            <Button Margin="5" Padding="10">Записаться</Button>
            <Button Margin="5" Padding="10">Отмена</Button>
        </WrapPanel>
    </DockPanel>
</Window>
